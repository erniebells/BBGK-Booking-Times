# SQLite for local MVP (no Docker required). For PostgreSQL, switch prisma/schema.prisma
# provider to postgresql and use the DATABASE_URL from docker-compose.
DATABASE_URL="file:./dev.db"
AUTH_SECRET="dev-change-me-to-a-long-random-string"
AUTH_TRUST_HOST="true"
# Leave SMTP unset in development to use console OTP delivery.
NODE_ENV="development"
