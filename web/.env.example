# Database connection
# For SQLite (local development):
DATABASE_URL="file:./dev.db"
# For PostgreSQL (Docker/production):
# DATABASE_URL="postgresql://golfclub:your-secure-password@localhost:5432/boggoms_golf"

# NextAuth
AUTH_SECRET="generate-with-openssl-rand-base64-32-or-similar"
AUTH_TRUST_HOST="true"

# Public URL for OAuth redirects (optional, auto-detected if behind proxy)
# Example: AUTH_URL="https://bookings.boggomsgolf.co.za"
# If unset and not behind a proxy, redirects may point to http://0.0.0.0:3000
AUTH_URL=""

# Trust proxy headers for rate limiting (set to "true" only behind reverse proxy)
TRUST_PROXY="false"

# Initial admin account (only used if no admin exists)
INITIAL_ADMIN_EMAIL="admin@boggomsgolf.co.za"
INITIAL_ADMIN_PASSWORD="change-this-to-a-secure-password"

# PostgreSQL (for Docker setup)
POSTGRES_PASSWORD="change-this-to-a-secure-password"

# Application port (Docker host port mapping)
APP_PORT=3100

# Email (optional - leave unset for console logging in development)
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM=

# Environment
NODE_ENV="development"
