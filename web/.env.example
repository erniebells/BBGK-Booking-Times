# Postgres (Docker Compose service hostname is `db`).
# For host-side Prisma/npm against published port 5432, use localhost instead of db:
# DATABASE_URL="postgresql://golf:golf@localhost:5432/golf_tee"
DATABASE_URL="postgresql://golf:golf@db:5432/golf_tee"

# Required by Auth.js. Put a long random string here — never commit a real secret.
# docker-compose loads this via env_file: .env (do not hardcode AUTH_SECRET in compose).
# Keep this value STABLE across rebuilds. Changing it invalidates session cookies and
# causes JWTSessionError ("no matching decryption secret") until you clear localhost cookies.
AUTH_SECRET="dev-change-me-to-a-long-random-string"

# Shared club password — first login is view-only until My Details (SA ID) is complete.
INITIAL_MEMBER_PASSWORD="BBGK2026"

# Separate admin password (use with admin email, e.g. admin@demo.golf).
# Prefer unquoted: ADMIN_PASSWORD=admin123!
ADMIN_PASSWORD=admin123!

# Trust the request Host header (needed behind Docker / reverse proxies).
AUTH_TRUST_HOST="true"

# Public app URL. For local Docker use http (not https) so session cookies work.
# Prefer unquoted so quote characters are not part of the value.
AUTH_URL=http://localhost:3000

# Optional override: force Secure cookies on/off. Leave unset to derive from AUTH_URL.
# Compose sets AUTH_COOKIE_SECURE=false for local http.
# AUTH_COOKIE_SECURE=false

# Optional: seed demo users + published days on container start (upserts; safe to re-run).
# Prefer one-shot: docker compose exec app npm run db:seed
# RUN_SEED=true

# Leave SMTP unset in development to use console OTP delivery.
NODE_ENV="development"
